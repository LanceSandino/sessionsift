{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm run test:mutation:unit"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/web/components/sessionFilters.ts",
    "src/web/components/timelineWindow.ts",
    "src/web/components/timelineJourney.ts",
    "src/web/sources.ts",
    "src/web/supportState.ts"
  ],
  "ignorePatterns": [
    "/.cache",
    "/coverage",
    "/dist",
    "/src/webui/dist"
  ],
  "disableTypeChecks": "src/web/**/*.{ts,tsx}",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "concurrency": 2,
  "timeoutMS": 10000
}
