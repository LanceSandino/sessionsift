# Copy to .env.sessionsift.local (ignored by Git). These are public deployment
# coordinates, not credentials. Never add Access service tokens to this file.
SESSIONSIFT_HOST_HOME=/Users/you
SESSIONSIFT_UID=501
SESSIONSIFT_GID=20
SESSIONSIFT_AGENT_PUBLIC_URL=https://sessionsift-local.example.com
SESSIONSIFT_BRIDGE_PUBLIC_URL=https://sessionsift.example.com
SESSIONSIFT_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
# Ordered exact allowlist: MAIN application first, then the /invite/* audience.
# Only the first audience can authorize main account/API/MCP routes.
SESSIONSIFT_ACCESS_AUD=YOUR_MAIN_ACCESS_APPLICATION_AUD,YOUR_INVITE_ACCESS_APPLICATION_AUD
