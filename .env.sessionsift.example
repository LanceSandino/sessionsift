# Non-secret public deployment settings. Do not commit Access service tokens.
SESSIONSIFT_ADDR=127.0.0.1:7777
SESSIONSIFT_ALLOW_DOCKER_TUNNEL=false
# Only the hosted bridge is tunneled. A native tunnel can use loopback; Docker
# Desktop requires this explicit wildcard bind plus the enforced loopback-peer guard.
SESSIONSIFT_BRIDGE_ADDR=0.0.0.0:7780
SESSIONSIFT_ALLOWED_ORIGINS=https://bridge.example.com,https://chatgpt.com
SESSIONSIFT_PUBLIC_URL=https://bridge.example.com
SESSIONSIFT_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
# Ordered exact allowlist: MAIN application first, then the /invite/* audience.
# Only the first audience can authorize main account/API/MCP routes.
SESSIONSIFT_ACCESS_AUD=YOUR_MAIN_ACCESS_APPLICATION_AUD,YOUR_INVITE_ACCESS_APPLICATION_AUD

# Bridge-only key-encryption key. The file is generated with mode 0600 when
# absent on first setup. Existing encrypted databases require their original key.
# Automatic snapshots retain database/key pairs privately. Never commit its value.
SESSIONSIFT_BRIDGE_KEK_FILE=/absolute/private/path/bridge.kek

# Optional: a user-supplied ChatGPT export ZIP/JSON watched for replacements.
# SESSIONSIFT_CHATGPT_EXPORT=/absolute/private/path/chatgpt-export.zip
